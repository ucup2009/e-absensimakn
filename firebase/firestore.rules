rules_version = '2';

// Aturan Firestore untuk aplikasi AI Studio E-Absensi.
//
// Bawaan di sini: semua pengguna yang sudah login (termasuk anonymous auth
// dari Firebase di AI Studio) boleh membaca, tetapi tidak boleh menulis dari
// browser. Penulisan dilakukan lewat panel admin atau skrip seed.
//
// Kalau aplikasi AI Studio belum memakai Firebase Auth sama sekali, ganti
// baris `allow read` di bawah dengan:
//     allow read: if true;
// Hanya lakukan itu untuk prototipe, jangan untuk data siswa sungguhan.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin penuh: user dengan custom claim admin === true.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Presensi: siswa hanya boleh membaca rekamannya sendiri.
    match /attendances/{attendanceId} {
      allow read: if signedIn() || request.auth.uid == resource.data.student_id;
    }

    // Pengaturan aplikasi sebaiknya tidak pernah bisa ditulis dari klien.
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
