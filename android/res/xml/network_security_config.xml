<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Aplikasi ini dipakai di jaringan madrasah dan alamat server bisa diganti
        dari dalam aplikasi (termasuk alamat http:// IP lokal), jadi HTTP biasa
        diizinkan. Sertifikat HTTPS tetap divalidasi seperti biasa.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
